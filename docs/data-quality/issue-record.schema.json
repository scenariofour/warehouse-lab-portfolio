{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warehouse Lab Issue Record v1.0",
  "type": "object",
  "required": [
    "contract_version",
    "issue_id",
    "title",
    "category",
    "data_origin",
    "source_lineage",
    "detection_rule",
    "metrics",
    "severity",
    "confidence",
    "root_cause",
    "hypothesized_causes",
    "business_decision_category",
    "business_decision",
    "potential_consequences",
    "resolution_options",
    "status",
    "review",
    "evidence_refs",
    "residual_uncertainty",
    "treatment"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "issue_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "IDENTIFIER",
        "RECONCILIATION",
        "DUPLICATE",
        "SKU_SIZE",
        "INVENTORY_SNAPSHOT",
        "LOCATION",
        "CLASSIFICATION",
        "EXPERIMENT_CONFOUNDER"
      ]
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "REAL_SOURCE_DERIVED"
      ]
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_file",
          "sha256",
          "record_ranges",
          "columns",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "record_ranges": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 2
              }
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "AFFECTED",
              "CONTRIBUTING_POPULATION",
              "DEFINITION_EVIDENCE"
            ]
          }
        }
      }
    },
    "detection_rule": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric_id",
          "affected_count",
          "unit",
          "population",
          "denominator",
          "denominator_definition",
          "calculation",
          "additivity"
        ],
        "additionalProperties": false,
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "affected_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "denominator": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "denominator_definition": {
            "type": "string",
            "minLength": 1
          },
          "calculation": {
            "type": "string",
            "minLength": 1
          },
          "additivity": {
            "type": "string",
            "enum": [
              "WITHIN_METRIC_ONLY",
              "NONADDITIVE"
            ]
          }
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "confidence": {
      "type": "object",
      "required": [
        "arithmetic",
        "interpretation",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "arithmetic": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "NOT_APPLICABLE"
          ]
        },
        "interpretation": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "hypothesized_causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "business_decision_category": {
      "type": "string",
      "enum": [
        "MEASUREMENT_BASELINE",
        "SOURCE_DEFINITION",
        "EXPERIMENT_DESIGN",
        "SLOTTING_HYPOTHESIS",
        "SPATIAL_FEASIBILITY"
      ]
    },
    "business_decision": {
      "type": "string",
      "minLength": 1
    },
    "potential_consequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolution_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Investigating",
        "Resolved",
        "Accepted Limitation",
        "Unresolved \u2014 Source Clarification Required"
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "state",
        "reviewer",
        "evidence_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "treatment": {
      "type": "object",
      "required": [
        "kind",
        "approval_ref",
        "before_ref",
        "after_ref",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "NORMALIZATION",
            "CORRECTION",
            "RETENTION"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "before_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
